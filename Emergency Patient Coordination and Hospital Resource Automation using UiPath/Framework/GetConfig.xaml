<Activity mc:Ignorable="sap sap2010" x:Class="Framework_GetConfig"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="out_Config" Type="OutArgument(x:Object)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="GetConfig" sap2010:WorkflowViewState.IdRef="Sequence_GC">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="v_ProjectRoot" />
      <Variable x:TypeArguments="x:String" Name="v_ConfigPath" />
      <Variable x:TypeArguments="x:String" Name="v_Raw" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:String)" Name="v_Dict" />
    </Sequence.Variables>

    <Assign DisplayName="Resolve project root">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[v_ProjectRoot]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[If(System.IO.File.Exists(System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "project.json")), System.IO.Directory.GetCurrentDirectory(), System.IO.Directory.GetParent(System.IO.Directory.GetCurrentDirectory()).FullName)]</InArgument>
      </Assign.Value>
    </Assign>

    <Assign DisplayName="Config.psv path">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[v_ConfigPath]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(v_ProjectRoot, "Data", "Config.psv")]</InArgument>
      </Assign.Value>
    </Assign>

    <ui:LogMessage DisplayName="Log: reading config" Level="Info"
      Message="[&quot;[GetConfig] Reading configuration from: &quot; &amp; v_ConfigPath]" />

    <If DisplayName="Config file missing?" Condition="[Not System.IO.File.Exists(v_ConfigPath)]">
      <If.Then>
        <Throw DisplayName="Throw: Config.psv not found"
          Exception="[New System.IO.FileNotFoundException(&quot;Config.psv not found at: &quot; &amp; v_ConfigPath)]" />
      </If.Then>
    </If>

    <ui:ReadTextFile DisplayName="Read Config.psv" FileName="[v_ConfigPath]" Content="[v_Raw]" />

    <Assign DisplayName="Parse Key|Value into Dictionary">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:String)">[v_Dict]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)">[v_Raw.Split(New Char() {ChrW(10)}, StringSplitOptions.RemoveEmptyEntries).Skip(1).Select(Function(l) l.Trim().Split("|"c)).Where(Function(a) a.Length &gt;= 1 AndAlso a(0).Trim() &lt;&gt; "").ToDictionary(Function(a) a(0).Trim(), Function(a) If(a.Length &gt;= 2, a(1).Trim(), ""), StringComparer.OrdinalIgnoreCase)]</InArgument>
      </Assign.Value>
    </Assign>

    <Assign DisplayName="Inject ProjectRoot key">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[v_Dict("ProjectRoot")]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[v_ProjectRoot]</InArgument>
      </Assign.Value>
    </Assign>

    <Assign DisplayName="Set out_Config">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Object">[out_Config]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Object">[v_Dict]</InArgument>
      </Assign.Value>
    </Assign>

    <ui:LogMessage DisplayName="Log: config loaded" Level="Info"
      Message="[&quot;[GetConfig] Loaded &quot; &amp; v_Dict.Count &amp; &quot; settings. Hospital: &quot; &amp; v_Dict(&quot;HospitalName&quot;)]" />
  </Sequence>
</Activity>
