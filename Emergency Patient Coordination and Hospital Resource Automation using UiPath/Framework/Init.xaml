    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim cfg As Dictionary(Of String, String) = CType(in_Config, Dictionary(Of String, String)) Dim projectRoot As String = cfg(&quot;ProjectRoot&quot;) Dim relDbPath As String = cfg(&quot;DatabasePath&quot;) ' e.g. Data\HospitalDB.db v_DBPath = System.IO.Path.Combine(projectRoot, relDbPath) ' Validate DB file exists If Not System.IO.File.Exists(v_DBPath) Then Throw New System.IO.FileNotFoundException(&quot;[Init] HospitalDB.db not found at: &quot; &amp; v_DBPath &amp; &quot;. Run Scripts\create_database.py first.&quot;) End If ' Build Microsoft.Data.Sqlite connection string v_ConnStr = &quot;Data Source=&quot; &amp; v_DBPath &amp; &quot;;Mode=ReadWriteCreate;Cache=Shared;&quot; ' Ensure Notifications folder exists Dim notifRel As String = If(cfg.ContainsKey(&quot;EmailOutputFolder&quot;), cfg(&quot;EmailOutputFolder&quot;), &quot;Data\Notifications&quot;) v_NotifDir = System.IO.Path.Combine(projectRoot, notifRel) If Not System.IO.Directory.Exists(v_NotifDir) Then System.IO.Directory.CreateDirectory(v_NotifDir) End If" DisplayName="Build DB Connection String" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
