      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Load Microsoft.Data.Sqlite from Python DLLs or NuGet cache Dim sqliteDll As String = &quot;C:\Users\Gurupatil\AppData\Local\Programs\Python\Python312\DLLs\sqlite3.dll&quot; ' We use System.Data.SQLite-style ADO through a helper approach ' Actual SQLite access uses the Python sqlite3 DLL natively via interop ' Test: just verify the file is accessible Dim fi As New System.IO.FileInfo(v_DBPath) If fi.Length &lt; 1000 Then Throw New Exception(&quot;[Init] HospitalDB.db appears empty or corrupt. Re-run create_database.py.&quot;) End If" DisplayName="Test DB Connection" sap2010:WorkflowViewState.IdRef="InvokeCode_2">
