<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_GenerateCaseStatus"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_CaseId" Type="InArgument(x:String)" />
    <x:Property Name="in_PatientName" Type="InArgument(x:String)" />
    <x:Property Name="in_RequiredDept" Type="InArgument(x:String)" />
    <x:Property Name="in_BedId" Type="InArgument(x:String)" />
    <x:Property Name="in_BedStatus" Type="InArgument(x:String)" />
    <x:Property Name="in_VentilatorId" Type="InArgument(x:String)" />
    <x:Property Name="in_VentilatorStatus" Type="InArgument(x:String)" />
    <x:Property Name="in_BloodGroup" Type="InArgument(x:String)" />
    <x:Property Name="in_RequiredBloodUnits" Type="InArgument(x:Int32)" />
    <x:Property Name="in_BloodStatus" Type="InArgument(x:String)" />
    <x:Property Name="in_DocSummary" Type="InArgument(x:String)" />
    <x:Property Name="in_DocumentStatus" Type="InArgument(x:String)" />
    <x:Property Name="in_ReadinessScore" Type="InArgument(x:Int32)" />
    <x:Property Name="in_FinalStatus" Type="InArgument(x:String)" />
    <x:Property Name="in_PendingAction" Type="InArgument(x:String)" />
    <x:Property Name="out_StatusReport" Type="OutArgument(x:String)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.Linq</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="GenerateCaseStatus" sap2010:WorkflowViewState.IdRef="Sequence_GCS">
    <Assign DisplayName="Build consolidated status report">
      <Assign.To><OutArgument x:TypeArguments="x:String">[out_StatusReport]</OutArgument></Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[String.Join(Environment.NewLine, New String() {"==============================================", " EMERGENCY CASE STATUS REPORT", "==============================================", " Case ID     : " &amp; in_CaseId, " Patient     : " &amp; in_PatientName, " Department  : " &amp; in_RequiredDept, " Generated   : " &amp; DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"), "----------------------------------------------", " RESOURCE STATUS", " Bed         : " &amp; If(String.IsNullOrEmpty(in_BedId), in_BedStatus, in_BedId &amp; " - " &amp; in_BedStatus), " Ventilator  : " &amp; If(in_VentilatorStatus = "Not_Required", "Not Required", If(in_VentilatorStatus = "Available", in_VentilatorId &amp; " - Available", in_VentilatorStatus)), " Blood       : " &amp; in_BloodGroup &amp; " x" &amp; in_RequiredBloodUnits &amp; " - " &amp; in_BloodStatus, " Documents   : " &amp; in_DocSummary, "----------------------------------------------", " READINESS ASSESSMENT (administrative only)", " Readiness   : " &amp; in_ReadinessScore &amp; "%", " Status      : " &amp; in_FinalStatus, " Pending     : " &amp; in_PendingAction, "----------------------------------------------", " SCORING BREAKDOWN", " Documents   : " &amp; If(in_DocumentStatus = "Complete", 25, 0) &amp; "/25", " Bed         : " &amp; If(in_BedStatus = "Available" OrElse in_BedStatus = "Reserved", 25, 0) &amp; "/25", " Ventilator  : " &amp; If(in_VentilatorStatus = "Available" OrElse in_VentilatorStatus = "Not_Required" OrElse in_VentilatorStatus = "Reserved", 25, 0) &amp; "/25", " Blood       : " &amp; If(in_BloodStatus = "Available" OrElse in_BloodStatus = "Reserved", 25, 0) &amp; "/25", "==============================================", " NOTE: administrative readiness only. All clinical", " decisions remain with authorised medical staff.", "=============================================="})]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage DisplayName="Log: status generated" Level="Info"
      Message="[&quot;[GenerateCaseStatus] &quot; &amp; in_CaseId &amp; &quot;  - report generated (&quot; &amp; out_StatusReport.Length &amp; &quot; chars)&quot;]" />
  </Sequence>
</Activity>
