<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_CheckBloodInventory"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_DbFolder" Type="InArgument(x:String)" />
    <x:Property Name="in_CaseId" Type="InArgument(x:String)" />
    <x:Property Name="in_BloodGroup" Type="InArgument(x:String)" />
    <x:Property Name="in_RequiredUnits" Type="InArgument(x:Int32)" />
    <x:Property Name="out_BloodStatus" Type="OutArgument(x:String)" />
    <x:Property Name="out_AvailableUnits" Type="OutArgument(x:Int32)" />
    <x:Property Name="out_BelowThreshold" Type="OutArgument(x:Boolean)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="CheckBloodInventory" sap2010:WorkflowViewState.IdRef="Sequence_CBI">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="v_Raw" />
      <Variable x:TypeArguments="x:Int32" Name="v_Avail" />
      <Variable x:TypeArguments="x:Int32" Name="v_MinThr" />
    </Sequence.Variables>

    <ui:LogMessage DisplayName="Log: blood check" Level="Info"
      Message="[&quot;[CheckBlood] &quot; &amp; in_CaseId &amp; &quot;  - need &quot; &amp; in_RequiredUnits &amp; &quot; unit(s) of &quot; &amp; in_BloodGroup]" />

    <TryCatch DisplayName="Query BLOOD_INVENTORY.psv">
      <TryCatch.Try>
        <Sequence>
          <ui:ReadTextFile DisplayName="Read BLOOD_INVENTORY.psv"
            FileName="[System.IO.Path.Combine(in_DbFolder, &quot;BLOOD_INVENTORY.psv&quot;)]" Content="[v_Raw]" />

          <Assign DisplayName="Available units for group">
            <Assign.To><OutArgument x:TypeArguments="x:Int32">[v_Avail]</OutArgument></Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Int32">[CInt(v_Raw.Split(New Char() {ChrW(10)}, StringSplitOptions.RemoveEmptyEntries).Skip(1).Select(Function(l) l.Trim().Split("|"c)).Where(Function(a) a.Length &gt;= 2 AndAlso a(0).Trim() = in_BloodGroup.Trim()).Select(Function(a) a(1).Trim()).DefaultIfEmpty("0").First())]</InArgument>
            </Assign.Value>
          </Assign>

          <Assign DisplayName="Minimum threshold for group">
            <Assign.To><OutArgument x:TypeArguments="x:Int32">[v_MinThr]</OutArgument></Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Int32">[CInt(v_Raw.Split(New Char() {ChrW(10)}, StringSplitOptions.RemoveEmptyEntries).Skip(1).Select(Function(l) l.Trim().Split("|"c)).Where(Function(a) a.Length &gt;= 3 AndAlso a(0).Trim() = in_BloodGroup.Trim()).Select(Function(a) a(2).Trim()).DefaultIfEmpty("3").First())]</InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:Exception">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:Exception" Name="ex_B" />
            </ActivityAction.Argument>
            <Throw DisplayName="Throw SE-001"
              Exception="[New Exception(&quot;SE-001: Blood inventory read error: &quot; &amp; ex_B.Message)]" />
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
    </TryCatch>

    <Assign DisplayName="out_AvailableUnits">
      <Assign.To><OutArgument x:TypeArguments="x:Int32">[out_AvailableUnits]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:Int32">[v_Avail]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="out_BloodStatus">
      <Assign.To><OutArgument x:TypeArguments="x:String">[out_BloodStatus]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[If(v_Avail &gt;= in_RequiredUnits, "Available", "Unavailable")]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="out_BelowThreshold">
      <Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_BelowThreshold]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:Boolean">[(v_Avail &gt;= in_RequiredUnits) AndAlso ((v_Avail - in_RequiredUnits) &lt; v_MinThr)]</InArgument></Assign.Value>
    </Assign>

    <ui:LogMessage DisplayName="Log: blood result" Level="Info"
      Message="[&quot;[CheckBlood] &quot; &amp; in_CaseId &amp; &quot;  - &quot; &amp; in_BloodGroup &amp; &quot; available=&quot; &amp; v_Avail &amp; &quot; needed=&quot; &amp; in_RequiredUnits &amp; &quot; -&gt; &quot; &amp; out_BloodStatus]" />
  </Sequence>
</Activity>
