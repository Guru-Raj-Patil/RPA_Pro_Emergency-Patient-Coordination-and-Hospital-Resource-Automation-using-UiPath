<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_WriteAuditLog"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_DbFolder" Type="InArgument(x:String)" />
    <x:Property Name="in_CaseId" Type="InArgument(x:String)" />
    <x:Property Name="in_Action" Type="InArgument(x:String)" />
    <x:Property Name="in_Description" Type="InArgument(x:String)" />
    <x:Property Name="in_PerformedBy" Type="InArgument(x:String)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="WriteAuditLog" sap2010:WorkflowViewState.IdRef="Sequence_WAL">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="v_Line" />
    </Sequence.Variables>
    <TryCatch DisplayName="Append audit row (non-fatal)">
      <TryCatch.Try>
        <Sequence>
          <Assign DisplayName="Build row">
            <Assign.To><OutArgument x:TypeArguments="x:String">[v_Line]</OutArgument></Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[String.Join("|", New String() {DateTime.Now.Ticks.ToString(), in_CaseId, in_Action, in_Description.Replace("|", "/").Replace(ChrW(13), " ").Replace(ChrW(10), " "), DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"), If(String.IsNullOrEmpty(in_PerformedBy), "Bot", in_PerformedBy)})]</InArgument>
            </Assign.Value>
          </Assign>
          <ui:AppendLine DisplayName="Append to AUDIT_LOG.psv"
            FileName="[System.IO.Path.Combine(in_DbFolder, &quot;AUDIT_LOG.psv&quot;)]" Text="[v_Line]" />
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:Exception">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:Exception" Name="ex_A" />
            </ActivityAction.Argument>
            <ui:LogMessage DisplayName="Log: audit failed" Level="Warn"
              Message="[&quot;[WriteAuditLog] Non-fatal: could not write audit row for &quot; &amp; in_CaseId &amp; &quot;: &quot; &amp; ex_A.Message]" />
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
    </TryCatch>
  </Sequence>
</Activity>
