<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_CheckBedAvailability"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_DbFolder" Type="InArgument(x:String)" />
    <x:Property Name="in_CaseId" Type="InArgument(x:String)" />
    <x:Property Name="in_RequiredDepartment" Type="InArgument(x:String)" />
    <x:Property Name="in_VentilatorRequired" Type="InArgument(x:Boolean)" />
    <x:Property Name="out_BedStatus" Type="OutArgument(x:String)" />
    <x:Property Name="out_AvailableBedId" Type="OutArgument(x:String)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="CheckBedAvailability" sap2010:WorkflowViewState.IdRef="Sequence_CBA">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="v_BedsRaw" />
      <Variable x:TypeArguments="x:String" Name="v_VentRaw" />
      <Variable x:TypeArguments="x:String" Name="v_BedId" />
    </Sequence.Variables>

    <ui:LogMessage DisplayName="Log: bed search" Level="Info"
      Message="[&quot;[CheckBed] &quot; &amp; in_CaseId &amp; &quot;  - dept=&quot; &amp; in_RequiredDepartment &amp; &quot; ventReq=&quot; &amp; in_VentilatorRequired]" />

    <TryCatch DisplayName="Query BEDS.psv / VENTILATORS.psv">
      <TryCatch.Try>
        <Sequence>
          <ui:ReadTextFile DisplayName="Read BEDS.psv"
            FileName="[System.IO.Path.Combine(in_DbFolder, &quot;BEDS.psv&quot;)]" Content="[v_BedsRaw]" />
          <ui:ReadTextFile DisplayName="Read VENTILATORS.psv"
            FileName="[System.IO.Path.Combine(in_DbFolder, &quot;VENTILATORS.psv&quot;)]" Content="[v_VentRaw]" />
          <Assign DisplayName="First suitable bed id">
            <Assign.To><OutArgument x:TypeArguments="x:String">[v_BedId]</OutArgument></Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[If(in_VentilatorRequired, v_BedsRaw.Split(New Char() {ChrW(10)}, StringSplitOptions.RemoveEmptyEntries).Skip(1).Select(Function(l) l.Trim().Split("|"c)).Where(Function(a) a.Length &gt;= 5 AndAlso a(1) = in_RequiredDepartment AndAlso a(3) = "Available" AndAlso v_VentRaw.Split(New Char() {ChrW(10)}, StringSplitOptions.RemoveEmptyEntries).Skip(1).Select(Function(x) x.Trim().Split("|"c)).Any(Function(x) x.Length &gt;= 2 AndAlso x(0) = a(4) AndAlso x(1) = "Available")).OrderBy(Function(a) a(0)).Select(Function(a) a(0)).FirstOrDefault(), v_BedsRaw.Split(New Char() {ChrW(10)}, StringSplitOptions.RemoveEmptyEntries).Skip(1).Select(Function(l) l.Trim().Split("|"c)).Where(Function(a) a.Length &gt;= 4 AndAlso a(1) = in_RequiredDepartment AndAlso a(3) = "Available").OrderBy(Function(a) a(0)).Select(Function(a) a(0)).FirstOrDefault())]</InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:Exception">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:Exception" Name="ex_Bed" />
            </ActivityAction.Argument>
            <Throw DisplayName="Throw SE-001"
              Exception="[New Exception(&quot;SE-001: Bed availability read error: &quot; &amp; ex_Bed.Message)]" />
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
    </TryCatch>

    <Assign DisplayName="out_AvailableBedId">
      <Assign.To><OutArgument x:TypeArguments="x:String">[out_AvailableBedId]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[If(v_BedId Is Nothing, "", v_BedId)]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="out_BedStatus">
      <Assign.To><OutArgument x:TypeArguments="x:String">[out_BedStatus]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[If(String.IsNullOrEmpty(v_BedId), "Unavailable", "Available")]</InArgument></Assign.Value>
    </Assign>

    <ui:LogMessage DisplayName="Log: bed result" Level="Info"
      Message="[&quot;[CheckBed] &quot; &amp; in_CaseId &amp; &quot;  - &quot; &amp; out_BedStatus &amp; If(out_AvailableBedId &lt;&gt; &quot;&quot;, &quot; bed=&quot; &amp; out_AvailableBedId, &quot;&quot;)]" />
  </Sequence>
</Activity>
