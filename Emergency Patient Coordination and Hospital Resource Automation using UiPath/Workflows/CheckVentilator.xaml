<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_CheckVentilator"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_DbFolder" Type="InArgument(x:String)" />
    <x:Property Name="in_CaseId" Type="InArgument(x:String)" />
    <x:Property Name="in_BedId" Type="InArgument(x:String)" />
    <x:Property Name="in_VentilatorRequired" Type="InArgument(x:Boolean)" />
    <x:Property Name="out_VentilatorStatus" Type="OutArgument(x:String)" />
    <x:Property Name="out_VentilatorId" Type="OutArgument(x:String)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="CheckVentilator" sap2010:WorkflowViewState.IdRef="Sequence_CV">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="v_BedsRaw" />
      <Variable x:TypeArguments="x:String" Name="v_VentRaw" />
      <Variable x:TypeArguments="x:String" Name="v_VentId" />
      <Variable x:TypeArguments="x:String" Name="v_VentStat" />
    </Sequence.Variables>

    <If DisplayName="Ventilator required?" Condition="[Not in_VentilatorRequired]">
      <If.Then>
        <Sequence DisplayName="Not required">
          <Assign>
            <Assign.To><OutArgument x:TypeArguments="x:String">[out_VentilatorStatus]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:String">["Not_Required"]</InArgument></Assign.Value>
          </Assign>
          <Assign>
            <Assign.To><OutArgument x:TypeArguments="x:String">[out_VentilatorId]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:String">["N/A"]</InArgument></Assign.Value>
          </Assign>
          <ui:LogMessage DisplayName="Log: vent not required" Level="Info"
            Message="[&quot;[CheckVentilator] &quot; &amp; in_CaseId &amp; &quot;  - ventilator not required&quot;]" />
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Required - check bed's linked ventilator">
          <ui:ReadTextFile DisplayName="Read BEDS.psv"
            FileName="[System.IO.Path.Combine(in_DbFolder, &quot;BEDS.psv&quot;)]" Content="[v_BedsRaw]" />
          <ui:ReadTextFile DisplayName="Read VENTILATORS.psv"
            FileName="[System.IO.Path.Combine(in_DbFolder, &quot;VENTILATORS.psv&quot;)]" Content="[v_VentRaw]" />
          <Assign DisplayName="Ventilator id linked to bed">
            <Assign.To><OutArgument x:TypeArguments="x:String">[v_VentId]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:String">[v_BedsRaw.Split(New Char() {ChrW(10)}, StringSplitOptions.RemoveEmptyEntries).Skip(1).Select(Function(l) l.Trim().Split("|"c)).Where(Function(a) a.Length &gt;= 5 AndAlso a(0) = in_BedId).Select(Function(a) a(4)).FirstOrDefault()]</InArgument></Assign.Value>
          </Assign>
          <Assign DisplayName="Ventilator status">
            <Assign.To><OutArgument x:TypeArguments="x:String">[v_VentStat]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:String">[v_VentRaw.Split(New Char() {ChrW(10)}, StringSplitOptions.RemoveEmptyEntries).Skip(1).Select(Function(l) l.Trim().Split("|"c)).Where(Function(a) a.Length &gt;= 2 AndAlso a(0) = v_VentId AndAlso v_VentId &lt;&gt; "").Select(Function(a) a(1)).FirstOrDefault()]</InArgument></Assign.Value>
          </Assign>
          <Assign>
            <Assign.To><OutArgument x:TypeArguments="x:String">[out_VentilatorId]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:String">[If(String.IsNullOrEmpty(v_VentId), "", v_VentId)]</InArgument></Assign.Value>
          </Assign>
          <Assign>
            <Assign.To><OutArgument x:TypeArguments="x:String">[out_VentilatorStatus]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:String">[If(v_VentStat = "Available", "Available", "Unavailable")]</InArgument></Assign.Value>
          </Assign>
          <ui:LogMessage DisplayName="Log: vent result" Level="Info"
            Message="[&quot;[CheckVentilator] &quot; &amp; in_CaseId &amp; &quot;  - &quot; &amp; out_VentilatorStatus &amp; &quot; vent=&quot; &amp; out_VentilatorId]" />
        </Sequence>
      </If.Else>
    </If>
  </Sequence>
</Activity>
