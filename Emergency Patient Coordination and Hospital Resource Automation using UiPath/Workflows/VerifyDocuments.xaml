<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_VerifyDocuments"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_DbFolder" Type="InArgument(x:String)" />
    <x:Property Name="in_CaseId" Type="InArgument(x:String)" />
    <x:Property Name="in_PatientId" Type="InArgument(x:String)" />
    <x:Property Name="in_ProjectRoot" Type="InArgument(x:String)" />
    <x:Property Name="in_RequiredDocsCsv" Type="InArgument(x:String)" />
    <x:Property Name="out_DocumentStatus" Type="OutArgument(x:String)" />
    <x:Property Name="out_MissingDocs" Type="OutArgument(x:String)" />
    <x:Property Name="out_DocSummary" Type="OutArgument(x:String)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="VerifyDocuments" sap2010:WorkflowViewState.IdRef="Sequence_VD">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="v_Folder" />
      <Variable x:TypeArguments="scg:List(x:String)" Name="v_Req" />
      <Variable x:TypeArguments="scg:List(x:String)" Name="v_Present" />
      <Variable x:TypeArguments="scg:List(x:String)" Name="v_Missing" />
      <Variable x:TypeArguments="x:String" Name="v_Raw" />
      <Variable x:TypeArguments="x:String" Name="v_Now" />
    </Sequence.Variables>

    <ui:LogMessage DisplayName="Log: doc verify start" Level="Info"
      Message="[&quot;[VerifyDocuments] &quot; &amp; in_CaseId &amp; &quot; / &quot; &amp; in_PatientId &amp; &quot;  - checking documents&quot;]" />

    <Assign DisplayName="Patient folder">
      <Assign.To><OutArgument x:TypeArguments="x:String">[v_Folder]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(in_ProjectRoot, "Patients", in_PatientId)]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Required doc types">
      <Assign.To><OutArgument x:TypeArguments="scg:List(x:String)">[v_Req]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="scg:List(x:String)">[in_RequiredDocsCsv.Split(","c).Select(Function(d) d.Trim()).Where(Function(d) d &lt;&gt; "").ToList()]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Present docs (file exists, any extension)">
      <Assign.To><OutArgument x:TypeArguments="scg:List(x:String)">[v_Present]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="scg:List(x:String)">[v_Req.Where(Function(d) New String() {".pdf", ".PDF", ".jpg", ".png", ".docx"}.Any(Function(e) System.IO.File.Exists(System.IO.Path.Combine(v_Folder, d &amp; e)))).ToList()]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Missing docs">
      <Assign.To><OutArgument x:TypeArguments="scg:List(x:String)">[v_Missing]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="scg:List(x:String)">[v_Req.Where(Function(d) Not v_Present.Contains(d)).ToList()]</InArgument></Assign.Value>
    </Assign>

    <Assign DisplayName="out_DocumentStatus">
      <Assign.To><OutArgument x:TypeArguments="x:String">[out_DocumentStatus]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[If(v_Missing.Count = 0, "Complete", "Incomplete")]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="out_MissingDocs">
      <Assign.To><OutArgument x:TypeArguments="x:String">[out_MissingDocs]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[String.Join(",", v_Missing)]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="out_DocSummary">
      <Assign.To><OutArgument x:TypeArguments="x:String">[out_DocSummary]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[v_Present.Count &amp; "/" &amp; v_Req.Count &amp; " documents present" &amp; If(v_Missing.Count &gt; 0, ". Missing: " &amp; String.Join(", ", v_Missing), "")]</InArgument></Assign.Value>
    </Assign>

    <Assign DisplayName="Now">
      <Assign.To><OutArgument x:TypeArguments="x:String">[v_Now]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")]</InArgument></Assign.Value>
    </Assign>

    <TryCatch DisplayName="Persist DOCUMENTS.psv (non-fatal)">
      <TryCatch.Try>
        <Sequence>
          <ui:ReadTextFile DisplayName="Read DOCUMENTS.psv"
            FileName="[System.IO.Path.Combine(in_DbFolder, &quot;DOCUMENTS.psv&quot;)]" Content="[v_Raw]" />
          <Assign DisplayName="Update this patient's rows">
            <Assign.To><OutArgument x:TypeArguments="x:String">[v_Raw]</OutArgument></Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[String.Join(Environment.NewLine, v_Raw.Split(New Char() {ChrW(10)}, StringSplitOptions.RemoveEmptyEntries).Select(Function(l) If(l.Trim().Split("|"c).Length &gt;= 6 AndAlso l.Trim().Split("|"c)(1) = in_PatientId, String.Join("|", New String() {l.Trim().Split("|"c)(0), l.Trim().Split("|"c)(1), l.Trim().Split("|"c)(2), l.Trim().Split("|"c)(3), If(v_Present.Contains(l.Trim().Split("|"c)(2)), "Present", "Missing"), If(v_Present.Contains(l.Trim().Split("|"c)(2)), v_Now, "")}), l.Trim())).Where(Function(x) x &lt;&gt; ""))]</InArgument>
            </Assign.Value>
          </Assign>
          <ui:WriteTextFile DisplayName="Write DOCUMENTS.psv"
            FileName="[System.IO.Path.Combine(in_DbFolder, &quot;DOCUMENTS.psv&quot;)]" Text="[v_Raw]" />
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:Exception">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:Exception" Name="ex_D" />
            </ActivityAction.Argument>
            <ui:LogMessage DisplayName="Log: doc persist failed" Level="Warn"
              Message="[&quot;[VerifyDocuments] Non-fatal: could not persist DOCUMENTS.psv: &quot; &amp; ex_D.Message]" />
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
    </TryCatch>

    <ui:LogMessage DisplayName="Log: doc result" Level="Info"
      Message="[&quot;[VerifyDocuments] &quot; &amp; in_CaseId &amp; &quot;  - &quot; &amp; out_DocSummary]" />
  </Sequence>
</Activity>
