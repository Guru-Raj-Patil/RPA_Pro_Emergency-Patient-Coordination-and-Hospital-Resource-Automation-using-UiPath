<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_ResetDatastore"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_DbFolder" Type="InArgument(x:String)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="ResetDatastore" sap2010:WorkflowViewState.IdRef="Sequence_RDS">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="v_Db" />
      <Variable x:TypeArguments="x:String" Name="v_Seed" />
    </Sequence.Variables>

    <Assign DisplayName="Resolve db folder">
      <Assign.To><OutArgument x:TypeArguments="x:String">[v_Db]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[If(String.IsNullOrEmpty(in_DbFolder), System.IO.Path.Combine(If(System.IO.File.Exists(System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), &quot;project.json&quot;)), System.IO.Directory.GetCurrentDirectory(), System.IO.Directory.GetParent(System.IO.Directory.GetCurrentDirectory()).FullName), &quot;Data&quot;, &quot;db&quot;), in_DbFolder)]</InArgument></Assign.Value>
    </Assign>

    <ui:LogMessage DisplayName="Log: reset start" Level="Info"
      Message="[&quot;[ResetDatastore] Restoring datastore to seed in: &quot; &amp; v_Db]" />

    <If DisplayName="db folder exists?" Condition="[Not System.IO.Directory.Exists(v_Db)]">
      <If.Then>
        <Throw DisplayName="Throw: db folder missing"
          Exception="[New System.IO.DirectoryNotFoundException(&quot;[ResetDatastore] Datastore folder not found: &quot; &amp; v_Db)]" />
      </If.Then>
    </If>

    <ui:WriteTextFile DisplayName="Reset EMERGENCY_CASES.psv"
      FileName="[System.IO.Path.Combine(v_Db, &quot;EMERGENCY_CASES.psv&quot;)]"
      Text="CaseId|PatientId|CaseStatus|DocumentStatus|BedStatus|VentilatorStatus|BloodStatus|ReadinessPercentage|PendingAction|CreatedAt|UpdatedAt" />

    <ui:WriteTextFile DisplayName="Reset RESOURCE_RESERVATIONS.psv"
      FileName="[System.IO.Path.Combine(v_Db, &quot;RESOURCE_RESERVATIONS.psv&quot;)]"
      Text="ReservationId|CaseId|ResourceType|ResourceId|Quantity|Status|ReservedAt" />

    <ui:WriteTextFile DisplayName="Reset AUDIT_LOG.psv"
      FileName="[System.IO.Path.Combine(v_Db, &quot;AUDIT_LOG.psv&quot;)]"
      Text="LogId|CaseId|Action|Description|Timestamp|PerformedBy" />

    <ui:WriteTextFile DisplayName="Clear TEST_RESULTS.psv (test artifact)"
      FileName="[System.IO.Path.Combine(v_Db, &quot;TEST_RESULTS.psv&quot;)]"
      Text="TestId|Scenario|Expected|Actual|Result" />

    <Assign DisplayName="Seed: BEDS">
      <Assign.To><OutArgument x:TypeArguments="x:String">[v_Seed]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[String.Join(Environment.NewLine, New String() {"BedId|Department|BedType|Status|VentilatorId|LastUpdated", "ICU-01|ICU|Premium|Occupied|V-01|2026-09-06 10:44:11", "ICU-02|ICU|Premium|Occupied|V-02|2026-09-06 10:44:11", "ICU-03|ICU|Premium|Available|V-03|2026-09-06 10:44:11", "ICU-04|ICU|Standard|Available|V-04|2026-09-06 10:44:11", "GEN-01|General|Standard|Occupied||2026-09-06 10:44:11", "GEN-02|General|Standard|Available||2026-09-06 10:44:11", "GEN-03|General|Standard|Available||2026-09-06 10:44:11", "GEN-04|General|Standard|Available||2026-09-06 10:44:11", "CARD-01|Cardiology|Premium|Available|V-05|2026-09-06 10:44:11", "CARD-02|Cardiology|Standard|Available||2026-09-06 10:44:11"})]</InArgument></Assign.Value>
    </Assign>
    <ui:WriteTextFile DisplayName="Reset BEDS.psv"
      FileName="[System.IO.Path.Combine(v_Db, &quot;BEDS.psv&quot;)]" Text="[v_Seed]" />

    <Assign DisplayName="Seed: VENTILATORS">
      <Assign.To><OutArgument x:TypeArguments="x:String">[v_Seed]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[String.Join(Environment.NewLine, New String() {"VentilatorId|Status|Location|LastUpdated", "V-01|Occupied|ICU Ward A|2026-09-06 10:44:11", "V-02|Occupied|ICU Ward A|2026-09-06 10:44:11", "V-03|Available|ICU Ward B|2026-09-06 10:44:11", "V-04|Available|ICU Ward B|2026-09-06 10:44:11", "V-05|Available|ICU Ward C|2026-09-06 10:44:11", "V-06|Available|ICU Ward C|2026-09-06 10:44:11"})]</InArgument></Assign.Value>
    </Assign>
    <ui:WriteTextFile DisplayName="Reset VENTILATORS.psv"
      FileName="[System.IO.Path.Combine(v_Db, &quot;VENTILATORS.psv&quot;)]" Text="[v_Seed]" />

    <Assign DisplayName="Seed: BLOOD_INVENTORY">
      <Assign.To><OutArgument x:TypeArguments="x:String">[v_Seed]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[String.Join(Environment.NewLine, New String() {"BloodGroup|AvailableUnits|MinimumThreshold|LastUpdated", "A+|15|3|2026-09-06 10:44:11", "A-|5|2|2026-09-06 10:44:11", "B+|12|3|2026-09-06 10:44:11", "B-|4|2|2026-09-06 10:44:11", "AB+|8|2|2026-09-06 10:44:11", "AB-|2|1|2026-09-06 10:44:11", "O+|20|5|2026-09-06 10:44:11", "O-|6|2|2026-09-06 10:44:11"})]</InArgument></Assign.Value>
    </Assign>
    <ui:WriteTextFile DisplayName="Reset BLOOD_INVENTORY.psv"
      FileName="[System.IO.Path.Combine(v_Db, &quot;BLOOD_INVENTORY.psv&quot;)]" Text="[v_Seed]" />

    <!-- ================= episode extension: care team / theatre / admission / billing / discharge ================= -->

    <ui:WriteTextFile DisplayName="Reset DOCTOR_ASSIGNMENTS.psv"
      FileName="[System.IO.Path.Combine(v_Db, &quot;DOCTOR_ASSIGNMENTS.psv&quot;)]"
      Text="AssignmentId|CaseId|DoctorId|Role|Specialty|AssignedAt|Status" />

    <ui:WriteTextFile DisplayName="Reset OT_SCHEDULE.psv"
      FileName="[System.IO.Path.Combine(v_Db, &quot;OT_SCHEDULE.psv&quot;)]"
      Text="SlotId|TheatreId|CaseId|SurgeonId|AnaesthetistId|ScheduledStart|ScheduledEnd|Status" />

    <ui:WriteTextFile DisplayName="Reset ADMISSIONS.psv"
      FileName="[System.IO.Path.Combine(v_Db, &quot;ADMISSIONS.psv&quot;)]"
      Text="AdmissionId|CaseId|PatientId|BedId|AttendingDoctorId|AdmittedAt|ExpectedStayDays|Status|DischargeReadyAt" />

    <ui:WriteTextFile DisplayName="Reset BILLING.psv"
      FileName="[System.IO.Path.Combine(v_Db, &quot;BILLING.psv&quot;)]"
      Text="ChargeId|CaseId|Category|Description|Quantity|UnitPrice|Amount|PostedAt" />

    <ui:WriteTextFile DisplayName="Reset DISCHARGES.psv"
      FileName="[System.IO.Path.Combine(v_Db, &quot;DISCHARGES.psv&quot;)]"
      Text="DischargeId|CaseId|PatientId|ClinicalClearanceBy|ClinicalClearanceAt|FinalBillAmount|PaymentStatus|FollowUpDate|DischargeSummaryPath|DischargedAt" />

    <ui:WriteTextFile DisplayName="Reset INSURANCE_CLAIMS.psv"
      FileName="[System.IO.Path.Combine(v_Db, &quot;INSURANCE_CLAIMS.psv&quot;)]"
      Text="ClaimId|CaseId|Insurer|PolicyNumber|ClaimAmount|PacketPath|Status|SubmittedAt" />

    <ui:WriteTextFile DisplayName="Reset PENDING_REQUIREMENTS.psv"
      FileName="[System.IO.Path.Combine(v_Db, &quot;PENDING_REQUIREMENTS.psv&quot;)]"
      Text="RequirementId|CaseId|PatientId|Type|RequestedValue|CurrentFallback|Priority|Status|CreatedAt|UpdatedAt|ResolvedAt" />

    <ui:WriteTextFile DisplayName="Reset PATIENT_DOCUMENT_DATA.psv"
      FileName="[System.IO.Path.Combine(v_Db, &quot;PATIENT_DOCUMENT_DATA.psv&quot;)]"
      Text="RecordId|PatientId|CaseId|DocumentType|Field|Value|ExtractedAt" />

    <Assign DisplayName="Seed: DEPARTMENTS">
