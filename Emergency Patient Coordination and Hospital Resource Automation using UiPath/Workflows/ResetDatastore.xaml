    <ui:WriteTextFile DisplayName="Reset OPERATING_THEATRES.psv"
      FileName="[System.IO.Path.Combine(v_Db, &quot;OPERATING_THEATRES.psv&quot;)]" Text="[v_Seed]" />

    <ui:LogMessage DisplayName="Log: reset done" Level="Info"
      Message="[&quot;[ResetDatastore] Datastore restored: 9 ledgers cleared, BEDS/VENTILATORS/BLOOD_INVENTORY/DEPARTMENTS/DOCTORS/OPERATING_THEATRES reseeded.&quot;]" />
  </Sequence>
</Activity>
