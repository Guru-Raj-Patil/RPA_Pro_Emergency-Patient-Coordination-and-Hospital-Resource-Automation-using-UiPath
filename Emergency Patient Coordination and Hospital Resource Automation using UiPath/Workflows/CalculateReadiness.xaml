<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_CalculateReadiness"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_DocumentStatus" Type="InArgument(x:String)" />
    <x:Property Name="in_BedStatus" Type="InArgument(x:String)" />
    <x:Property Name="in_VentilatorStatus" Type="InArgument(x:String)" />
    <x:Property Name="in_BloodStatus" Type="InArgument(x:String)" />
    <x:Property Name="out_ReadinessScore" Type="OutArgument(x:Int32)" />
    <x:Property Name="out_FinalStatus" Type="OutArgument(x:String)" />
    <x:Property Name="out_PendingAction" Type="OutArgument(x:String)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.Linq</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="CalculateReadiness" sap2010:WorkflowViewState.IdRef="Sequence_CR">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="v_Pend" />
    </Sequence.Variables>

    <Assign DisplayName="Score = 4 x 25%">
      <Assign.To><OutArgument x:TypeArguments="x:Int32">[out_ReadinessScore]</OutArgument></Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">[If(in_DocumentStatus = "Complete", 25, 0) + If(in_BedStatus = "Available" OrElse in_BedStatus = "Reserved", 25, 0) + If(in_VentilatorStatus = "Available" OrElse in_VentilatorStatus = "Not_Required" OrElse in_VentilatorStatus = "Reserved", 25, 0) + If(in_BloodStatus = "Available" OrElse in_BloodStatus = "Reserved", 25, 0)]</InArgument>
      </Assign.Value>
    </Assign>

    <Assign DisplayName="Final status">
      <Assign.To><OutArgument x:TypeArguments="x:String">[out_FinalStatus]</OutArgument></Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[If(out_ReadinessScore = 100, "READY_FOR_APPROVAL", If(in_BedStatus = "Unavailable", "PENDING_BED", If(in_VentilatorStatus = "Unavailable", "PENDING_VENTILATOR", If(in_BloodStatus = "Unavailable", "PENDING_BLOOD", If(in_DocumentStatus = "Incomplete", "PENDING_DOCUMENTATION", "PENDING")))))]</InArgument>
      </Assign.Value>
    </Assign>

    <Assign DisplayName="Pending items list">
      <Assign.To><OutArgument x:TypeArguments="x:String">[v_Pend]</OutArgument></Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[String.Join("; ", New String() {If(in_DocumentStatus = "Complete", "", "Complete document verification"), If(in_BedStatus = "Available" OrElse in_BedStatus = "Reserved", "", "Locate available bed"), If(in_VentilatorStatus = "Available" OrElse in_VentilatorStatus = "Not_Required" OrElse in_VentilatorStatus = "Reserved", "", "Locate available ventilator"), If(in_BloodStatus = "Available" OrElse in_BloodStatus = "Reserved", "", "Secure blood inventory")}.Where(Function(s) s &lt;&gt; ""))]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="out_PendingAction">
      <Assign.To><OutArgument x:TypeArguments="x:String">[out_PendingAction]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[If(v_Pend = "", "None", v_Pend)]</InArgument></Assign.Value>
    </Assign>

    <ui:LogMessage DisplayName="Log: readiness" Level="Info"
      Message="[&quot;[CalculateReadiness] score=&quot; &amp; out_ReadinessScore &amp; &quot;% status=&quot; &amp; out_FinalStatus &amp; &quot; pending: &quot; &amp; out_PendingAction]" />
  </Sequence>
</Activity>
