<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_RequestHumanApproval"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_DbFolder" Type="InArgument(x:String)" />
    <x:Property Name="in_Config" Type="InArgument(x:Object)" />
    <x:Property Name="in_CaseId" Type="InArgument(x:String)" />
    <x:Property Name="in_StatusReport" Type="InArgument(x:String)" />
    <x:Property Name="out_ApprovalDecision" Type="OutArgument(x:String)" />
    <x:Property Name="out_ApproverNotes" Type="OutArgument(x:String)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="RequestHumanApproval" sap2010:WorkflowViewState.IdRef="Sequence_RHA">
    <Sequence.Variables>
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:String)" Name="v_Cfg" />
      <Variable x:TypeArguments="x:Boolean" Name="v_Auto" />
      <Variable x:TypeArguments="x:String" Name="v_NotifDir" />
      <Variable x:TypeArguments="x:Object" Name="v_Ignore" />
    </Sequence.Variables>

    <Assign DisplayName="Cast config">
      <Assign.To><OutArgument x:TypeArguments="scg:Dictionary(x:String, x:String)">[v_Cfg]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)">[CType(in_Config, Dictionary(Of String, String))]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Auto-approve flag">
      <Assign.To><OutArgument x:TypeArguments="x:Boolean">[v_Auto]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:Boolean">[If(v_Cfg.ContainsKey("AutoApproveWhenReady"), v_Cfg("AutoApproveWhenReady"), "True").Trim().ToUpper() = "TRUE"]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Notifications dir">
      <Assign.To><OutArgument x:TypeArguments="x:String">[v_NotifDir]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(v_Cfg("ProjectRoot"), If(v_Cfg.ContainsKey("EmailOutputFolder"), v_Cfg("EmailOutputFolder"), "Data\Notifications"))]</InArgument></Assign.Value>
    </Assign>
    <Assign DisplayName="Ensure dir">
      <Assign.To><OutArgument x:TypeArguments="x:Object">[v_Ignore]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:Object">[System.IO.Directory.CreateDirectory(v_NotifDir)]</InArgument></Assign.Value>
    </Assign>

    <ui:WriteTextFile DisplayName="Write approval-request file"
      FileName="[System.IO.Path.Combine(v_NotifDir, &quot;APPROVAL_&quot; &amp; in_CaseId &amp; &quot;.txt&quot;)]"
      Text="[&quot;ACTION REQUIRED - authorised staff review&quot; &amp; Environment.NewLine &amp; &quot;Case: &quot; &amp; in_CaseId &amp; Environment.NewLine &amp; &quot;Created: &quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;) &amp; Environment.NewLine &amp; Environment.NewLine &amp; in_StatusReport]" />

    <If DisplayName="Auto-approve?" Condition="[v_Auto]">
      <If.Then>
        <Sequence>
          <Assign>
            <Assign.To><OutArgument x:TypeArguments="x:String">[out_ApprovalDecision]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:String">["Approved"]</InArgument></Assign.Value>
          </Assign>
          <Assign>
            <Assign.To><OutArgument x:TypeArguments="x:String">[out_ApproverNotes]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:String">["[Auto-approved: AutoApproveWhenReady=True. Human approval point is represented by APPROVAL_" &amp; in_CaseId &amp; ".txt - in production this is a UiPath Action Center task.]"]</InArgument></Assign.Value>
          </Assign>
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence>
          <Assign>
            <Assign.To><OutArgument x:TypeArguments="x:String">[out_ApprovalDecision]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:String">["Pending"]</InArgument></Assign.Value>
          </Assign>
          <Assign>
            <Assign.To><OutArgument x:TypeArguments="x:String">[out_ApproverNotes]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:String">["Awaiting authorised staff review - see APPROVAL_" &amp; in_CaseId &amp; ".txt"]</InArgument></Assign.Value>
          </Assign>
        </Sequence>
      </If.Else>
    </If>

    <ui:LogMessage DisplayName="Log: approval decision" Level="Info"
      Message="[&quot;[RequestHumanApproval] &quot; &amp; in_CaseId &amp; &quot;  - decision: &quot; &amp; out_ApprovalDecision]" />
  </Sequence>
</Activity>
