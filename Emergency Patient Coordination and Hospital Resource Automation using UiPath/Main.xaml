                            <ui:InvokeCode ContinueOnError="{x:Null}" DisplayName="Check for Duplicate CaseId" sap2010:WorkflowViewState.IdRef="InvokeCode_4">
                <ui:InvokeCode.Code>
                  <![CDATA[
Dim pyFile As String = System.IO.Path.Combine(System.IO.Path.GetTempPath(), "uipath_dupcheck_" & v_CaseId & ".py")
Dim dbPathSafe As String = v_DBPath.Replace("\", "/")
Dim pyScript As String = "import sqlite3" & Environment.NewLine &
    "conn = sqlite3.connect(r'" & dbPathSafe & "')" & Environment.NewLine &
    "r = conn.execute(""SELECT COUNT(*) FROM EMERGENCY_CASES WHERE CaseId=?"", (""" & v_CaseId & """,)).fetchone()" & Environment.NewLine &
    "print(r[0])" & Environment.NewLine &
    "conn.close()"
System.IO.File.WriteAllText(pyFile, pyScript)
Dim psi As New System.Diagnostics.ProcessStartInfo("python", """" & pyFile & """")
psi.UseShellExecute = False
psi.CreateNoWindow = True
psi.RedirectStandardOutput = True
psi.RedirectStandardError = True
Dim p As System.Diagnostics.Process = System.Diagnostics.Process.Start(psi)
Dim cnt As String = p.StandardOutput.ReadToEnd().Trim()
Dim errOut As String = p.StandardError.ReadToEnd().Trim()
p.WaitForExit(5000)
If p.ExitCode <> 0 Then Throw New Exception("SE-003: Duplicate-check Python failed: " & errOut) End If
If Integer.Parse(cnt) > 0 Then Throw New Exception("BE-007: Duplicate CaseId detected: " & v_CaseId & " for PatientId=" & v_PatientId) End If
Try : System.IO.File.Delete(pyFile) : Catch : End Try
                  ]]>
