    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim cfg As Dictionary(Of String, String) = CType(v_Config, Dictionary(Of String, String)) Dim projRoot As String = cfg(&quot;ProjectRoot&quot;) Dim inputPath As String = System.IO.Path.Combine(projRoot, &quot;Data&quot;, &quot;PatientInput.xlsx&quot;) If Not System.IO.File.Exists(inputPath) Then Throw New System.IO.FileNotFoundException(&quot;PatientInput.xlsx not found: &quot; &amp; inputPath) End If ' Read via Excel COM Dim xlApp As Object = CreateObject(&quot;Excel.Application&quot;) xlApp.Visible = False xlApp.DisplayAlerts = False Dim wb As Object = xlApp.Workbooks.Open(inputPath) Dim ws As Object = wb.Sheets(&quot;EmergencyRequests&quot;) Dim lastRow As Integer = ws.Cells(ws.Rows.Count, 1).End(-4162).Row ' Build list of rows as Dictionary Dim rows As New List(Of Dictionary(Of String, String))() For r As Integer = 2 To lastRow Dim status As String = CStr(If(ws.Cells(r, 10).Value2, &quot;Pending&quot;)) If status.Trim() = &quot;Pending&quot; Then Dim row As New Dictionary(Of String, String)(StringComparer.OrdinalIgnoreCase) row(&quot;PatientId&quot;) = CStr(If(ws.Cells(r, 1).Value2, &quot;&quot;)) row(&quot;Name&quot;) = CStr(If(ws.Cells(r, 2).Value2, &quot;&quot;)) row(&quot;Age&quot;) = CStr(If(ws.Cells(r, 3).Value2, &quot;0&quot;)) row(&quot;Gender&quot;) = CStr(If(ws.Cells(r, 4).Value2, &quot;&quot;)) row(&quot;EmergencyType&quot;) = CStr(If(ws.Cells(r, 5).Value2, &quot;&quot;)) row(&quot;RequiredDepartment&quot;) = CStr(If(ws.Cells(r, 6).Value2, &quot;&quot;)) row(&quot;VentilatorRequired&quot;) = CStr(If(ws.Cells(r, 7).Value2, &quot;No&quot;)) row(&quot;BloodGroup&quot;) = CStr(If(ws.Cells(r, 8).Value2, &quot;&quot;)) row(&quot;BloodUnits&quot;) = CStr(If(ws.Cells(r, 9).Value2, &quot;0&quot;)) row(&quot;RowNum&quot;) = r.ToString() rows.Add(row) End If Next wb.Close(False) xlApp.Quit() System.Runtime.InteropServices.Marshal.ReleaseComObject(xlApp) v_InputRows = rows v_TotalRows = rows.Count" DisplayName="Read PatientInput.xlsx" sap2010:WorkflowViewState.IdRef="InvokeCode_2">
